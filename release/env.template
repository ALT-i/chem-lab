# CHM Virtual Lab settings. Copy to /opt/chemlab/.env and replace every value in angle brackets.
# Use only letters and numbers in passwords and keys (make them with: openssl rand -hex 32).

# --- Release ---
CHEMLAB_VERSION=__VERSION__

# --- Core ---
DJANGO_SETTINGS_MODULE=src.config.stage
DJANGO_SECRET_KEY=<random string>
DJANGO_DEBUG=False
SITE_URL=https://<backend web address>

# --- Database ---
DB_NAME=chemlab
DB_USER=chemlab
DB_PASSWORD=<random string>
DB_HOST=db
DB_PORT=5432

# --- Background jobs (used to send emails) ---
BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp server name>
EMAIL_PORT=25
EMAIL_FROM=<sender address>

# --- Moodle ---
MOODLE_BASE_URL=https://<moodle web address, no slash at the end>
MOODLE_TOKEN=<web service token>
MOODLE_COURSE_ID=<CHM 191 course ID>
MOODLE_DEFAULT_ASSIGNMENT_ID=<assignment ID>

# --- Admin dashboard uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_PRESET_SUBSTANCES=chemlab_substances
CLOUDINARY_PRESET_APPARATUS=chemlab_apparatus
CLOUDINARY_PRESET_PROFILES=chemlab_profiles
CLOUDINARY_PRESET_LESSON_IMAGES=chemlab_lesson_images
CLOUDINARY_PRESET_LESSON_VIDEOS=chemlab_lesson_videos

# --- Optional ---
SENTRY_DSN=
